# Port the Express server listens on
PORT=3000

# Path to the SQLite database file (parent directory is created automatically).
# In Docker the default is /data/app.db (a declared volume).
DB_PATH=./data/app.db

# Set to "production" in deployed environments. Controls secure cookie flag.
NODE_ENV=development

# Optional: overrides the build timestamp reported by /api/healthz.
# BUILD_TIME=2025-01-01T00:00:00Z
