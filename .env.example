# --- Database ------------------------------------------------------------
# Postgres connection string. The server checks these vars in order:
#   POSTGRES_URL  (set automatically by Vercel Postgres / Neon integration)
#   POSTGRES_URL_NON_POOLING
#   DATABASE_URL  (used in local dev / Docker)
#
# Local default (matches docker-compose.yml in this repo):
DATABASE_URL=postgres://talks:talks@localhost:5432/talks

# --- Server --------------------------------------------------------------
# Port the Express server listens on (local dev / Docker only; ignored on Vercel)
PORT=3000

# Set to "production" in deployed environments. Controls secure cookie flag.
NODE_ENV=development

# --- Vercel-only flags ---------------------------------------------------
# Vercel automatically sets VERCEL=1, which disables the SSE endpoint so
# the client falls back to 5-second polling (serverless functions cannot
# share an in-memory subscriber list across invocations).

# --- Optional ------------------------------------------------------------
# Override the build timestamp reported by /api/healthz.
# BUILD_TIME=2025-01-01T00:00:00Z

# Disable the "seed 8 sample talks if the talks table is empty" behavior.
# AUTO_SEED=false
