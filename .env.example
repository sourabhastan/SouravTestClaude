# --- Local development ---------------------------------------------------
# Local libSQL uses a file URL; no auth token needed. The data/ directory
# is created automatically. Leave these as-is to develop locally with a
# SQLite file under ./data/.
TURSO_DATABASE_URL=file:./data/app.db
# TURSO_AUTH_TOKEN=

# Port the Express server listens on (local dev / Docker only; ignored on Vercel)
PORT=3000

# Set to "production" in deployed environments. Controls secure cookie flag.
NODE_ENV=development

# --- Vercel (Turso cloud) -----------------------------------------------
# In the Vercel dashboard, set the following project environment variables:
#   TURSO_DATABASE_URL=libsql://<your-db>-<org>.turso.io
#   TURSO_AUTH_TOKEN=<token from `turso db tokens create`>
# Vercel automatically sets VERCEL=1, which disables the SSE endpoint
# (clients fall back to 5-second polling).

# Optional: overrides the build timestamp reported by /api/healthz.
# BUILD_TIME=2025-01-01T00:00:00Z

# Optional: set to "false" to skip the auto-seed-on-empty behavior.
# AUTO_SEED=false
